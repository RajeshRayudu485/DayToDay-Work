Build a Jenkins CI/CD pipeline for a Java web application.

The pipeline should:

1.Checkout code from GitHub.

2.Build the application using Maven.

3.Analyze code using SonarQube and check Quality Gate.

4.Upload the WAR file to Nexus.

5.Build Docker images for the app and database.

6.Scan Docker images using Trivy.

7.Deploy using Docker Compose.

8.Send an email notification after successful deployment.

TASK
  
pipeline {
    agent any 
    tools {
        maven 'MyMaven'
    }
    environment {
        MYSQL_ROOT_PASSWORD='devopspassword'
    }
    stages {
        stage ("Code") {
            steps {
                git 'https://github.com/RajeshRayudu485/dockerwebapp.git'
            }
        }
        stage ("Build") {
            steps {
                sh 'mvn clean install'
            }
        }
        stage ("CQA") {
            steps {
                withSonarQubeEnv(credentialsId: 'mysonar', installationName: 'mysonar') {
                    sh '''
                    mvn clean verify org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                    -Dsonar.projectKey=my-appilication \
                    -Dsonar.projectName='my appilication' \
                    -Dsonar.host.url=http://54.153.13.81:9000 \
                    -Dsonar.token=sqp_ea8d9e9761b68df78697a021724c886b39ea1855
                    '''
                }
            }
        }
        stage ("Quality Gates") {
            steps {
                waitForQualityGate abortPipeline: true, credentialsId: 'mysonar'
            }
        }
        stage ("Artifact") {
            steps {
                nexusArtifactUploader artifacts: [[artifactId: 'vprofile', classifier: '', file: 'target/vprofile-v2.war', type: 'war']], credentialsId: 'nexus', groupId: 'com.visualpathit', nexusUrl: '54.219.176.15:8081', nexusVersion: 'nexus3', protocol: 'http', repository: 'MyRepo', version: 'V2'
            }
        }
        stage ("Docker Build") {
            steps {
                sh  '''
                    docker build \
                    -t appimage:latest \
                    -f Docker-app/Dockerfile \
                .

                    docker build \
                    -t dbimage:latest \
                    -f Docker-db/Dockerfile \
                    Docker-db
                '''
            }
        }
        stage ("Trivy Scan") {
            steps {
                sh '''
                    trivy image --scanners vuln --timeout 5m appimage:latest
                    trivy image --scanners vuln --timeout 5m dbimage:latest
                '''
            }
        }
        stage ("Compose") {
            steps {
                sh 'docker compose -f compose.yml up -d'
            }
        }
    }
}
post {
        success {
            mail to: 'rajeshrayudu122@gmail.com',
            subject: "Build Status: ${currentBuild.fullDisplayName}",
            body: "The build ${env.BUILD_NUMBER} finished with status: ${currentBuild.currentResult}. View logs at: ${env.BUILD_URL}"
        }
}
