Build a Jenkins CI/CD pipeline for a Java web application.

The pipeline should:

1.Checkout code from GitHub.

2.Build the application using Maven.

3.Analyze code using SonarQube and check Quality Gate.

4.Upload the WAR file to Nexus.

5.Build Docker images for the app and database.

6.Scan Docker images using Trivy.

7.Deploy using Docker Compose.

8.Send an email notification after successful deployment.

TASK
  
pipeline {
    agent {
        node {
            label 'prod'
        }
    }
    tools {
        maven 'MyMaven'
    }
    stages {
        stage ("Code") {
            steps {
                git 'https://github.com/RajeshRayudu485/dockerwebapp.git'
            }
        }
        stage ("Build") {
            steps {
                sh 'mvn clean install'
            }
        }
        stage ("CQA") {
            steps {
                withSonarQubeEnv('mysonar') {
                   sh 'mvn clean verify org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dsonar.projectKey=myproject'
                }
            }
        }
        stage ("QualityGates") {
            steps {
                waitForQualityGate abortPipeline: true, credentialsId: 'mysonar'
            }
        }
        stage ("Artifact") {
            steps {
                nexusArtifactUploader artifacts: [[artifactId: 'vprofile', classifier: '', file: 'target/vprofile-v2.war', type: 'war']], credentialsId: 'nexus', groupId: 'com.visualpathit', nexusUrl: '54.176.241.88:8081', nexusVersion: 'nexus3', protocol: 'http', repository: 'MyRepo', version: 'v2'
            }
        }
        stage ("Images") {
            steps {
                sh 'cp -r target Docker-app'
                sh  'docker build -t appimage Docker-app' 
                sh  'docker build -t dbimage Docker-db' 
            }
        }
        stage ("Scan Images") {
            steps {
                sh 'trivy image appimage:latest >> appimage.txt'
                sh 'trivy image dbimage:latest >> dbimage.txt'
            }
        }
        stage ("Docker Registry") {
            steps {
                script {
                    withDockerRegistry(credentialsId:'Docker') {
                        sh 'docker tag appimage rajeshrayudu2022/mydeploy:javaapp'
                        sh 'docker tag dbimage rajeshrayudu2022/mydeploy:db'
                        sh 'docker push rajeshrayudu2022/mydeploy:javaapp'
                        sh 'docker push rajeshrayudu2022/mydeploy:db'
                    }
                }
            }
        }
        stage ("Deploy") {
            steps {
                sh 'docker stack deploy myapp --compose-file=compose.yml'
            }
        }
    }
    post {
        success {
            mail(
                to: 'rajeshrayudu122@gmail.com',
                subject: "Build Status: ${currentBuild.fullDisplayName}",
                body: "Build ${env.BUILD_NUMBER} finished with status: ${currentBuild.currentResult}. View logs at: ${env.BUILD_URL}"
            )
        }
    }
}
